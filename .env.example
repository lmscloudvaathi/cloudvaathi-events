TIDB_HOST=gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=cloud_vaathi

# TLS to TiDB: use a file locally, or paste the full PEM into TIDB_CA on Cloudflare (Workers have no stable disk path).
TIDB_CA_PATH=isrgrootx1.pem
# TIDB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=replace_with_long_secret

ADMIN_SEED_EMAIL=admin@cloudvaathi.com
ADMIN_SEED_PASSWORD=replace_with_admin_password
ADMIN_SEED_NAME=Cloud Vaathi Admin

RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=replace_with_secret

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=gmail_app_password

APP_BASE_URL=http://localhost:8080

# --- Cloudflare Workers (production) ---
# Non-secret defaults live in wrangler.jsonc → "vars" (version-controlled, applied every deploy).
# Secrets are NOT committed: run once after clone or when rotating keys:
#   npm run cf:push-secrets
# (uses this file copied to .env locally; requires `npx wrangler login`)
