{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudvaathi-events",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",

  // Redeployed from git on every build — avoids “empty Variables” when CI only runs wrangler deploy.
  // Replace placeholders with your real TiDB/Gmail/Razorpay *public* IDs (same ideas as .env.example).
  // Passwords & PEM must NEVER live here — use: npm run cf:push-secrets (reads local .env).
  "vars": {
    "APP_BASE_URL": "https://cloudvaathi-events.lmscloudvaathi.workers.dev",
    "TIDB_HOST": "gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com",
    "TIDB_PORT": "4000",
    "TIDB_DATABASE": "cloud_vaathi",
    "TIDB_USER": "your_tidb_user",
    "ADMIN_SEED_EMAIL": "admin@cloudvaathi.com",
    "ADMIN_SEED_NAME": "Cloud Vaathi Admin",
    "GMAIL_USER": "you@gmail.com",
    "RAZORPAY_KEY_ID": "rzp_live_xxx"
  }
}
