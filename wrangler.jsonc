{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudvaathi-events",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",

  // Login uses bcrypt; Free plan (10ms CPU) kills the Worker with Error 1102 / HTTP 503.
  // Requires Workers Paid (Standard). Raise if login still 503s after deploy.
  "limits": {
    "cpu_ms": 60000
  },

  // Redeployed from git on every build — avoids “empty Variables” when CI only runs wrangler deploy.
  // Replace placeholders with your real TiDB/Gmail/Razorpay *public* IDs (same ideas as .env.example).
  // Passwords & PEM must NEVER live here — use: npm run cf:push-secrets (reads local .env).
  "vars": {
    "APP_BASE_URL": "https://events.cloudvaathi.in",
    "TIDB_HOST": "gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com",
    "TIDB_PORT": "4000",
    "TIDB_DATABASE": "cloud_vaathi",
    "TIDB_USER": "4Vobd5ZCyt1QisJ.root",
    "ADMIN_SEED_EMAIL": "jagathishwaranparthiban@iqmath.in",
    "ADMIN_SEED_NAME": "Jagathishwaran Parthiban",
    "GMAIL_USER": "lmscloudvaathi@gmail.com",
    "RAZORPAY_KEY_ID": "rzp_live_SmnIHTMb63Ulu7"
  }
}
